# Anthropic (the only paid piece; a few dollars a month at this volume)
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override models
JOBHUNTER_MODEL=claude-opus-5

# WhatsApp Cloud API (Meta for Developers, free test number)
WHATSAPP_TOKEN=EAAB...                # permanent System User token
WHATSAPP_PHONE_NUMBER_ID=1234567890   # the test number's Phone number ID
WHATSAPP_VERIFY_TOKEN=any-random-string-you-choose
WHATSAPP_APP_SECRET=...               # App > Settings > Basic > App secret
WHATSAPP_TEMPLATE=jobhunter_ping      # approved utility template with 1 body param (see README)
EDDIE_WHATSAPP=972543203976           # Eddie's number, no plus sign

# Optional: secret to protect manual trigger URLs (/.netlify/functions/scan?key=...)
JOBHUNTER_ADMIN_KEY=change-me
