# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Optional model overrides
COMPANION_MODEL=claude-opus-5-5           # conversation
COMPANION_EXTRACT_MODEL=claude-haiku-4-5  # memory extraction (cheap model, per the plan)

# Protects /api/admin/* (creating parents, reading alerts)
COMPANION_ADMIN_KEY=change-me
# Human safety coverage (the operator), Israel time. Outside these hours an SOS
# goes to the family contact only and nobody is promised a human.
COVERAGE_TZ=Asia/Jerusalem
COVERAGE_START=08:00
COVERAGE_END=22:00

# Operator SOS alerts by email (Resend). With onboarding@resend.dev as the sender,
# Resend only delivers to the email address of the Resend account itself.
RESEND_API_KEY=
OPERATOR_EMAIL=                            # comma-separated for more than one
ALERT_FROM_EMAIL=                          # sender for SOS and weekly emails, on a domain verified in Resend, e.g. "Companion <hello@yourdomain.com>"

# Optional: WhatsApp (Meta Cloud API). Parents with a WhatsApp number talk there;
# webhook: https://<site>/api/whatsapp, subscribed to "messages".
WHATSAPP_TOKEN=                            # permanent System User token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=                       # App settings > Basic; verifies webhook signatures
WHATSAPP_VERIFY_TOKEN=                     # any random string, entered again in Meta's webhook setup
WHATSAPP_DISPLAY_NUMBER=                   # the companion's number as shown to families, e.g. +15551234567
WHATSAPP_TEMPLATES_APPROVED=               # 1 once companion_checkin and companion_reminder are approved (src/templates.ts)
WHATSAPP_TEMPLATE=                         # operator alerts: approved utility template with 1 body param
OPERATOR_WHATSAPP=                         # operator's number, no plus sign
